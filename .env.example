# ============================================================
# PQC Secure-Code Reviewer Agent — Environment Configuration
# ============================================================
# Copy this file to .env and populate with your API keys.

# --- LLM Provider API Key ---
# Gemini (default)
GOOGLE_API_KEY=your-gemini-api-key-here

# Claude (alternative)
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenAI (alternative)
# OPENAI_API_KEY=your-openai-api-key-here

# --- Agent Configuration ---
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-pro
LLM_TEMPERATURE=0.1
